    /**
    * Show the application dashboard.
    *
    * @return \Illuminate\Contracts\Support\Renderable
    */
    public function index()
    {    
        $today_request = DB::table('tbl_sim_request')->whereBetween('created_at', [date('Y-m-d')." 00:00:01",date('Y-m-d')." 23:59:59"])->count();
        $shipped = DB::table('delivery_history')->where('type','1')->whereBetween('time', [date('Y-m-d')." 00:00:01",date('Y-m-d')." 23:59:59"])->count();
        $activated = DB::table('delivery_history')->where('type','2')->whereBetween('time', [date('Y-m-d')." 00:00:01",date('Y-m-d')." 23:59:59"])->count();
        $sim_sold = DB::table('tbl_sim_list')->whereBetween('created_at', [date('Y-m-d')." 00:00:01",date('Y-m-d')." 23:59:59"])->count();          
        return view('dashboard',compact('today_request','shipped','activated','sim_sold'));
    }

