        $sims = DB::table('tbl_sim_stock as ts')->select('ts.id','phone_number','category','ts.status','box_no','price', DB::raw('CONCAT(a.first_name," ",a.last_name) as fullname'))->join('admins as a','dealer_id','=','a.id');

