    /**
    * Show the Port report pagination.
    *
    * @return \Illuminate\Contracts\Support\Renderable
    */
    public function list_port(Request $request)
    { 
        $users = DB::table('tbl_porting as tp')->select(['tp.id', 'pac_number','porting_to', 'provider', 'reference_id', 'expected_date', 'description','tp.created_at', 'ss.phone_number','ss.temp_number','tp.status'])
                    ->join('tbl_sim_stock as ss','ss.id','=','stock_id');

        if ($request->status != -1) {
            $users->where('tp.status',$request->status);
        }
        $users = $users->get();
        $result = Datatables::of($users)
                ->editColumn('status', function ($user) {
                    $stat = "";
                    switch ($user->status) {
                        case 0:
                            $stat = "Received";
                            break;
                        case 1:
                            $stat = "Initiated";
                            break;
                        case 2:
                            $stat = "Confirmed";
                            break;
                        case 3:
                            $stat = "Processed";
                            break;
                        case 4:
                            $stat = "Completed";
                            break;
                        case 5:
                            $stat = "Canceled";
                            break;
                        default:
                            $stat = "";
                            break;
                    }
                return $stat;
                })
                ->editColumn('created_at', function ($user) {
                return $user->created_at ? with(new Carbon($user->created_at))->format('d-m-Y') : '';
                })
                ->make(true);

        if($request->exportdata){
            $result = collect($result->getData()->data);
            $datas = $result->map(function ($item,$key) {
                return collect($item)->except(['id']);
             });
            $datas->prepend(array('PAC NUMBER','PORTING TO','PROVIDER','REFERENCE ID','EXPECTED DATE','DESCRIPTION','CREATED AT','PHONE NUMBER','TEMP NUMBER','STATUS'));

            return Excel::download(new CustomExport($datas->toArray()), 'porting.csv');
        }else{
        return $result;
        }
    }

